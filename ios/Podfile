# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'GoodKid' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # Xcode 27 refuses to build pods whose deployment target is below iOS 15,
    # and several pods (resource bundles mostly) still declare 9.0–13.4. Lift
    # them to the app's own minimum so they never ask for less than it does.
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |build_config|
        deployment_target = build_config.build_settings['IPHONEOS_DEPLOYMENT_TARGET']
        if deployment_target.nil? || Gem::Version.new(deployment_target) < Gem::Version.new(min_ios_version_supported)
          build_config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = min_ios_version_supported
        end

        # fmt 11.0 turns on consteval format checks under C++20, and the clang in
        # Xcode 27 rejects its own format-inl.h with them. C++17 compiles fmt
        # with runtime checks, which is what it does on older toolchains anyway.
        if target.name == 'fmt'
          build_config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'c++17'
        end
      end
    end

    # The Swift compiler in Xcode 27 synthesizes a memberwise
    # init(stringRepresentation:) for RevenueCat's PaywallColor, which clashes
    # with the public throwing init of the same name. Upstream fixed it by moving
    # the designated init into the struct body (an explicit init there stops the
    # synthesis); the RevenueCat that react-native-purchases 9.x pins predates
    # that, so the same move is made here until the SDK is upgraded.
    paywall_color = File.join(installer.sandbox.root.to_s, 'RevenueCat/Sources/Paywalls/PaywallColor.swift')
    if File.exist?(paywall_color)
      source = File.read(paywall_color)
      designated = "    /// \"Designated\" initializer\n" \
                   "    private init(stringRepresentation: String, underlyingColor: (any Sendable)?) {\n" \
                   "        self.stringRepresentation = stringRepresentation\n" \
                   "        self._underlyingColor = underlyingColor\n" \
                   "    }\n"
      stored = "    fileprivate var _underlyingColor: (any Sendable)?\n"
      if source.include?(designated + "\n}\n\n// MARK: - Errors") && source.include?(stored)
        source = source.sub(designated, '').sub(stored, stored + "\n" + designated)
        File.chmod(0644, paywall_color)
        File.write(paywall_color, source)
      end
    end
  end
end
