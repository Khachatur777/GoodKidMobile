{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "experimentalDecorators": true,
    // Единственные .js в src — вендорная копия keyboard-aware-scroll-view с
    // Flow-аннотациями. Пока tsc их читал, он спотыкался на синтаксисе и не
    // проверял типы во всём остальном проекте.
    "allowJs": false,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "lib": [
      "es6",
      "dom",
      "es2016",
      "es2017",
      "es2018",
      "es2019",
    ],
    "typeRoots" : ["node_modules/@types","src/types"],
    // Базовый конфиг React Native задаёт "bundler" вместе с customConditions;
    // переопределение на "node" конфликтовало с ними, и tsc отказывался
    // работать вовсе.
    "noEmit": true,
    "strict": true,
    "target": "esnext",
    "baseUrl": ".",
    "paths": {
      "*": ["src/*"],
      "@assets": ["src/assets/index"],
      "@app-constants": ["src/app-constants/index"],
      "@atoms": ["src/atoms/index"],
      "@configs": ["src/configs/index"],
      "@helpers": ["src/helpers/index"],
      "@hooks": ["src/hooks/index"],
      "@localization": ["src/localization/index"],
      "@models": ["src/models/index"],
      "@molecules": ["src/molecules/index"],
      "@navigation": ["src/navigation/index"],
      "@organisms": ["src/organisms/index"],
      "@rtk": ["src/rtk/api/index"],
      "@screens": ["src/screens/index"],
      "@theme": ["src/theme/index"],
      "@types": ["src/types/index"],
      "@utils": ["src/utils/index"],
      "@validators": ["src/validators/index"],
      "@packages": ["src/packages/index"],
    }
  },
  "include": ["./src/**/*"],
  "exclude": [
    "node_modules",
    "babel.config.js",
    "metro.config.js",
    // Вендорный код с Flow-аннотациями. Для tsc это синтаксические ошибки, а
    // при них он выводит только их и до проверки типов не доходит вовсе — то
    // есть весь остальной проект оставался непроверенным.
    "src/molecules/keyboard-aware-scroll-view/KeyboardAwareHOC.js",
    "src/molecules/keyboard-aware-scroll-view/KeyboardAwareHOC.web.js",
    "src/molecules/keyboard-aware-scroll-view/KeyboardAwareInterface.js",
  ]
}
